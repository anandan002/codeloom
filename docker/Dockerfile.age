FROM apache/age:v1.7.0-pg17

# Install pgvector on top of the AGE base image
RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends build-essential git postgresql-server-dev-17 \
    && git clone --depth 1 --branch v0.8.0 https://github.com/pgvector/pgvector.git /tmp/pgvector \
    && cd /tmp/pgvector && make && make install \
    && rm -rf /tmp/pgvector \
    && apt-get purge -y build-essential git postgresql-server-dev-17 \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*
